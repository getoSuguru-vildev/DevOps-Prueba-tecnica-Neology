{
  "uid": "parking-api",
  "title": "Parking API",
  "tags": ["parking", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Disponibilidad (SLI, 5m) vs SLO 99.5%",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "1 - (sli:api_error_ratio:rate5m or vector(0))" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.995 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Peticiones < 300 ms (SLI, 5m) vs SLO 95%",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sli:api_fast_ratio:rate5m" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Presupuesto de error restante (30d)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - ((sum(increase(http_server_requests_seconds_count{job=\"parking-backend\", uri=~\"/neo/.*\", status=~\"5..\"}[30d])) or vector(0)) / sum(increase(http_server_requests_seconds_count{job=\"parking-backend\", uri=~\"/neo/.*\"}[30d]))) / 0.005"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "green", "value": 0.5 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Alertas activas",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Peticiones por status (/neo/**)",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"parking-backend\", uri=~\"/neo/.*\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latencia p50 / p95 / p99",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"parking-backend\", uri=~\"/neo/.*\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"parking-backend\", uri=~\"/neo/.*\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"parking-backend\", uri=~\"/neo/.*\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pool de conexiones a PostgreSQL (Hikari)",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(hikaricp_connections_active{job=\"parking-backend\"})", "legendFormat": "activas" },
        { "refId": "B", "expr": "sum(hikaricp_connections_idle{job=\"parking-backend\"})", "legendFormat": "libres" },
        { "refId": "C", "expr": "sum(hikaricp_connections_pending{job=\"parking-backend\"})", "legendFormat": "esperando" },
        { "refId": "D", "expr": "sum(hikaricp_connections_max{job=\"parking-backend\"})", "legendFormat": "máximo" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM: memoria heap",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{job=\"parking-backend\", area=\"heap\"})", "legendFormat": "heap usado" },
        { "refId": "B", "expr": "sum(jvm_memory_max_bytes{job=\"parking-backend\", area=\"heap\"} > 0)", "legendFormat": "heap máximo" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ]
}
