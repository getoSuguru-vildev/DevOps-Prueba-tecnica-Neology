# Copiar a .env y ajustar. El archivo .env está ignorado por git.
# Los valores de ejemplo son exclusivamente para desarrollo local:
# en AWS la contraseña de PostgreSQL la administra Secrets Manager (ver docs/security.md).

# PostgreSQL
POSTGRES_DB=parking
POSTGRES_USER=parking
POSTGRES_PASSWORD=change_me_local_only

# Puertos publicados en el host
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Etiqueta de las imágenes construidas localmente (en CI se usa sha-<commit>)
IMAGE_TAG=local

# Formato de logs del backend: json (contenedores) o text (depuración)
LOG_FORMAT=json

# Perfil opcional de observabilidad (Prometheus + Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change_me_local_only
